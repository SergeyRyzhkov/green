{
  "name": "tipa-faq",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "process": "tsx src/process.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "format": "biome format --write src",
    "check": "npm run typecheck && npm run lint",
    "validate": "tsx src/validate.ts",
    "faq:ai": "tsx src/process.ts --ai-missing",
    "faq:reclassify-sections": "tsx src/process.ts --reclassify-sections"
  },
  "dependencies": {
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}

{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",

  "files": {
    "includes": ["**", "!node_modules", "!data"]
  },

  "formatter": {
    "enabled": true,
    "formatWithErrors": true,
    "indentStyle": "space",
    "indentWidth": 2
  },

  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  }
}
